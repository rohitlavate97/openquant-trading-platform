# ==============================================================================
# OpenQuant Platform Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual API keys or broker secrets to version control.
# Copy this file to .env and adjust variables for your deployment environment.

# ------------------------------------------------------------------------------
# Application & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="OpenQuant Algorithmic Trading Platform"
SECRET_KEY=change_this_to_a_secure_random_64_byte_hex_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Security & Strategy Execution Sandbox
# ------------------------------------------------------------------------------
SANDBOX_MAX_CPU_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_EXECUTION_TIMEOUT_SECONDS=60
SANDBOX_STRICT_ALLOWLIST_MODE=true

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openquant
POSTGRES_PASSWORD=openquant_dev_password
POSTGRES_DB=openquant_db
DATABASE_URL=postgresql+asyncpg://openquant:openquant_dev_password@localhost:5432/openquant_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Risk Engine Defaults (Hard Stops)
# ------------------------------------------------------------------------------
RISK_GLOBAL_KILL_SWITCH_ACTIVE=false
RISK_DEFAULT_MAX_DAILY_LOSS_PERCENT=3.0
RISK_DEFAULT_MAX_DRAWDOWN_PERCENT=5.0
RISK_DEFAULT_MAX_POSITION_SIZE_PERCENT=10.0
RISK_MAX_ORDERS_PER_SECOND=10

# ------------------------------------------------------------------------------
# Market Data Freshness Thresholds
# ------------------------------------------------------------------------------
MARKET_DATA_STALENESS_THRESHOLD_MS=3000
