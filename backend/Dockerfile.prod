# Multi-stage Production Dockerfile for OpenQuant Trading Platform Backend
# syntax=docker/dockerfile:1.4

FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

WORKDIR /app

# Install build dependencies & uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Dependency caching stage
COPY pyproject.toml .
RUN uv sync --frozen --no-install-project --no-dev

# Copy source code and install project
COPY . .
RUN uv sync --frozen --no-dev

# Production runtime stage
FROM python:3.13-slim AS runtime

LABEL maintainer="OpenQuant Engineering <engineering@openquant.io>"
LABEL description="OpenQuant Production Trading Engine"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    ENVIRONMENT=production

WORKDIR /app

# Create non-root system user & group for least privilege security
RUN groupadd -r openquant && useradd -r -g openquant -s /sbin/nologin -d /app openquant \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment and application code from builder
COPY --from=builder --chown=openquant:openquant /app /app

USER openquant

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/system/health || exit 1

# Launch FastAPI via Gunicorn with Uvicorn workers for production concurrency
CMD ["uvicorn", "openquant.interfaces.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--http", "httptools", "--log-level", "info"]
